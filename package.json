{
  "name": "takatrack-api",
  "version": "2.0.0",
  "description": "Modern personal finance tracker API with wallet, transaction, and loan management",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "node dist/server.js",
    "start:dev": "ts-node src/server.ts",
    "dev": "nodemon src/server.ts",
    "build": "tsc",
    "postbuild": "npx prisma generate",
    "deploy": "npm run build && npx prisma migrate deploy",
    "db:migrate": "npx prisma migrate deploy",
    "db:seed": "npx prisma db seed",
    "db:studio": "npx prisma studio",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "finance",
    "tracker",
    "wallet",
    "expense",
    "income",
    "loan",
    "personal-finance",
    "api",
    "rest-api"
  ],
  "author": "S M MEJBA UL HAQUE",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MHS88BD/takatrack.com.git"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/pdfkit": "^0.17.3",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "csv-writer": "^1.6.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.17.2",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "nodemon": "^3.1.11"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}